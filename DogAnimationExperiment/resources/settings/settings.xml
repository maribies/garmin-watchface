<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!-- All values are ARGB2222-safe: each R/G/B channel is one of
         {0x00, 0x55, 0xAA, 0xFF}, so fenix7s/fenix7spro's 4-level-per-channel
         display can't shift them the way the sprite gray did in Phase 1. -->
    <setting propertyKey="@Properties.BackgroundColor" title="@Strings.BackgroundColorTitle">
        <settingConfig type="list">
            <listEntry value="0xFFAAAA">@Strings.ColorLightRed</listEntry>
            <listEntry value="0xAAAAFF">@Strings.ColorLightBlue</listEntry>
            <listEntry value="0xFFFFAA">@Strings.ColorLightYellow</listEntry>
            <listEntry value="0xAAFFAA">@Strings.ColorLightGreen</listEntry>
            <listEntry value="0xFFAAFF">@Strings.ColorLightPurple</listEntry>
            <listEntry value="0xFFAA55">@Strings.ColorLightOrange</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.UseMilitaryFormat" title="@Strings.MilitaryFormatTitle">
        <settingConfig type="boolean" />
    </setting>

    <!-- Up to 6 fields shown at once, out of 9 candidates. Which ones are
         on determines position (fill order: bottom-left, bottom-right,
         middle-left, middle-right, top-left, top-right, in that fixed
         evaluation order below) — no per-slot picker needed. -->
    <setting propertyKey="@Properties.ShowSteps" title="@Strings.ShowStepsTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowHeartRate" title="@Strings.ShowHeartRateTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowWeather" title="@Strings.ShowWeatherTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowBodyBattery" title="@Strings.ShowBodyBatteryTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowCalories" title="@Strings.ShowCaloriesTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowNotifications" title="@Strings.ShowNotificationsTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowFloors" title="@Strings.ShowFloorsTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowIntensityMinutes" title="@Strings.ShowIntensityMinutesTitle">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowDistance" title="@Strings.ShowDistanceTitle">
        <settingConfig type="boolean" />
    </setting>

</settings>
